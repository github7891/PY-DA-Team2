   "id": "937f1215-54a1-469c-bd97-61df37a2a5f3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert back to numpy for keras\n",
    "X_train_full = X_train_full.to_numpy()\n",
    "X_valid = X_valid.to_numpy()\n",
    "X_test = X_test.to_numpy()"
   ]
  },
  {
